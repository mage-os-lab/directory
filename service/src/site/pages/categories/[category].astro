---
/**
 * Category pages used to be a second, prerendered listing. Browsing by
 * category is now a filter on the one directory list, so this route only
 * keeps old links alive: it sends the reader to the home page with the
 * category preselected. Static hosting has no server redirect, hence the
 * meta refresh; the canonical link keeps search engines on the target.
 */
import { loadFeed } from '../../lib/data.js';
import { withBase } from '../../lib/base.js';

export function getStaticPaths() {
  const feed = loadFeed();
  return feed.categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const target = withBase(`/?category=${encodeURIComponent(category.slug)}`);
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>{category.name} · Mage-OS Extension Directory</title>
  </head>
  <body>
    <p>
      Browsing by category now happens on the directory itself. Continue to
      <a href={target}>{category.name} modules</a>.
    </p>
  </body>
</html>
