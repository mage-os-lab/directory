---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/base.js';
import { loadFeed, packageHref, packagesForCategory } from '../../lib/data.js';
import { qualityLabel } from '../../../shared/quality.js';

export function getStaticPaths() {
  const feed = loadFeed();
  return feed.categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const feed = loadFeed();
const packages = packagesForCategory(feed, category.slug);

---

<Base title={category.name} description={`${category.name} modules in the Mage-OS Extension Directory.`}>
  <h1>{category.name}</h1>
  <p>
    <a href={withBase(`/?category=${category.slug}`)}>Search within this category →</a>
  </p>

  {
    packages.length === 0 ? (
      <p>No visible packages in this category right now.</p>
    ) : (
      <ul class="package-grid">
        {packages.map((pkg) => (
          <li class="package-card">
            <h3>
              <a href={packageHref(pkg)}>{pkg.displayName}</a>
            </h3>
            <p class="package-name">
              <code>{pkg.name}</code>
            </p>
            <p class="description">{pkg.description}</p>
            <p class="meta">
              <span class={`badge badge-${pkg.quality.tier ?? 'untested'}`}>
                {qualityLabel(pkg.quality.tier)}
              </span>
              {pkg.trust.editorialPick && <span class="badge badge-pick">Editors&rsquo; pick</span>}
              {pkg.trust.trustedVendor && <span class="badge badge-trusted">Trusted vendor</span>}
              {pkg.popularity.installs !== null && (
                <span class="stat">{pkg.popularity.installs.toLocaleString()} installs</span>
              )}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</Base>
