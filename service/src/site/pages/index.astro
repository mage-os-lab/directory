---
import Base from '../layouts/Base.astro';
import SearchIsland from '../components/SearchIsland.js';
import { withBase } from '../lib/base.js';
import { qualityLabel } from '../../shared/quality.js';
import {
  categoryHref,
  editorialPicks,
  loadFeed,
  packageHref,
} from '../lib/data.js';

const feed = loadFeed();
const picks = editorialPicks(feed, 6);
const categories = feed.categories
  .filter((c) => c.packageCount > 0)
  .sort((a, b) => b.packageCount - a.packageCount);

// Hero counters (PM-style): visible modules by readiness.
const visible = feed.packages.filter((p) => !p.trust.hidden);
const readyCount = visible.filter(
  (p) => p.quality.tier !== null && p.quality.tier !== 'needs-help',
).length;
const needsHelpCount = visible.filter((p) => p.quality.tier === 'needs-help').length;
const vendorCount = new Set(visible.map((p) => p.vendor)).size;
---

<Base
  title="Home"
  description="A trustworthy, quality-tested catalog of open-source Magento and Mage-OS modules, powered by PackageMaven data."
>
  <section class="hero">
    <h1>Find Magento &amp; Mage-OS modules you can trust</h1>
    <p>
      The Mage-OS Extension Directory is a quality-tested catalog of open-source Magento 2 and
      Mage-OS modules. Every listing is backed by <a href="https://package-maven.com/" rel="noopener">PackageMaven</a>'s
      real compatibility testing against actual Magento versions — not just parsed Composer
      constraints — plus a human-curated trust layer for vendor track record and editorial picks.
    </p>
    <p class="hero-stats">
      <span class="hero-stat"><strong>{visible.length}</strong> modules</span>
      <span class="hero-stat hero-stat-ready"><strong>{readyCount}</strong> ready to install</span>
      <span class="hero-stat hero-stat-help"><strong>{needsHelpCount}</strong> need help</span>
      <span class="hero-stat"><strong>{vendorCount}</strong> vendors</span>
    </p>
  </section>

  {
    picks.length > 0 && (
      <section class="section" id="editorial-picks">
        <h2>Editors&rsquo; picks</h2>
        <p class="section-intro">
          Maintainer-selected modules, independent of any partner relationship — see{' '}
          <a href={withBase('/how-to-get-listed/')}>how badges work</a>.
        </p>
        <ul class="pick-grid">
          {picks.map((pkg) => (
            <li class="package-card">
              <h3>
                <a href={packageHref(pkg)}>{pkg.displayName}</a>
              </h3>
              <p class="package-name">
                <code>{pkg.name}</code>
              </p>
              <p class="description">{pkg.description}</p>
              <p class="meta">
                {pkg.quality.tier && (
                  <span class={`badge badge-${pkg.quality.tier}`}>
                    {qualityLabel(pkg.quality.tier)}
                  </span>
                )}
                <span class="badge badge-pick">Editors&rsquo; pick</span>
                {pkg.trust.trustedVendor && <span class="badge badge-trusted">Trusted vendor</span>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="section" id="categories">
    <h2>Browse by category</h2>
    <ul class="category-grid">
      {categories.map((c) => (
        <li>
          <a class="category-card" href={categoryHref(c.slug)}>
            <span class="category-name">{c.name}</span>{' '}
            <span class="category-count">({c.packageCount})</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="search">
    <h2>Search &amp; browse all modules</h2>
    <SearchIsland client:load />
  </section>
</Base>
