---
import '../styles/site.css';
import { withBase } from '../lib/base.js';
import { loadFeed, staleNotice } from '../lib/data.js';

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A trustworthy, quality-tested catalog of open-source Magento and Mage-OS modules, powered by PackageMaven data.',
} = Astro.props;

const feed = loadFeed();
const dataAsOf = staleNotice(feed);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Mage-OS Extension Directory</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // A host that frames a page says so in the URL. The Magento admin
      // frames detail pages in its own light chrome: ?scheme=light keeps the
      // frame from going dark on its own, and ?embed=1 drops the site header,
      // whose navigation makes no sense inside a modal that already names
      // the page. Both are set before the body paints, and both are carried
      // through in-page links so a related listing opened inside the frame
      // stays framed.
      (function () {
        var params = new URLSearchParams(location.search);
        var scheme = params.get('scheme');
        var embed = params.get('embed') === '1';
        if (scheme !== 'light' && scheme !== 'dark') scheme = null;
        if (scheme) document.documentElement.setAttribute('data-theme', scheme);
        if (embed) document.documentElement.setAttribute('data-embed', '');
        if (!scheme && !embed) return;
        document.addEventListener(
          'click',
          function (event) {
            var target = event.target;
            var link = target && target.closest ? target.closest('a[href]') : null;
            if (!link || link.origin !== location.origin) return;
            var url = new URL(link.href);
            if (scheme && !url.searchParams.has('scheme')) url.searchParams.set('scheme', scheme);
            if (embed && !url.searchParams.has('embed')) url.searchParams.set('embed', '1');
            link.href = url.href;
          },
          true,
        );
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-logo" href={withBase('/')}>Mage-OS Extension Directory</a>
        <nav class="site-nav">
          <a href={withBase('/')}>Home</a>
          <a href={withBase('/how-to-get-listed/')}>How to get listed</a>
        </nav>
      </div>
    </header>
    {
      dataAsOf && (
        <p class="stale-banner" role="status">
          Quality data as of {dataAsOf.slice(0, 10)} — the live PackageMaven source was
          unavailable at the last update.
        </p>
      )
    }
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <p class="pm-attribution">
          Quality and compatibility data by <a href="https://package-maven.com/" rel="noopener">PackageMaven</a>.
          Package metadata from <a href="https://packagist.org/" rel="noopener">Packagist</a>.
        </p>
        <p>
          <a href={withBase('/how-to-get-listed/')}>What do these badges mean?</a> — trusted vendor, partner
          tier, and editorial pick, explained.
        </p>
        <p class="trademark-disclaimer">
          Magento is a registered trademark of Adobe Inc. Mage-OS is not affiliated with Adobe;
          no endorsement implied.
        </p>
      </div>
    </footer>
  </body>
</html>
