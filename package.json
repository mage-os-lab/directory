{
  "name": "@mage-os/extension-directory",
  "version": "0.1.0",
  "private": true,
  "description": "Mage-OS Extension Directory: static data pipeline + catalog site",
  "type": "module",
  "license": "OSL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhoerr/mage-os.directory.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pipeline": "tsx src/pipeline/run.ts --out public",
    "pipeline:fixture": "tsx src/pipeline/run.ts --source fixture --out public",
    "build": "npm run pipeline:fixture && astro build",
    "build:ui": "vite build --config vite.ui.config.ts",
    "dev": "npm run pipeline:fixture && astro dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && astro check",
    "format:vendors": "tsx src/pipeline/tools/format-vendors.ts",
    "generate:schemas": "tsx src/pipeline/tools/generate-json-schema.ts",
    "validate:data": "tsx src/pipeline/tools/validate-data.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.0",
    "astro": "^7.0.5",
    "minisearch": "^7.2.0",
    "preact": "^10.29.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^26.1.0",
    "happy-dom": "^20.10.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
