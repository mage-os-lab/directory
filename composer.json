{
    "name": "mage-os/module-extension-directory",
    "description": "Browse the Mage-OS Extension Directory from the Magento admin panel, enriched with the shop's installed modules and Magento version.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.1.0",
    "require": {
        "php": ">=8.1",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "MageOS\\ExtensionDirectory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MageOS\\ExtensionDirectory\\Test\\Unit\\": "dev/tests/unit/Test/"
        }
    },
    "scripts": {
        "test": "phpunit -c dev/tests/unit/phpunit.xml.dist"
    }
}
