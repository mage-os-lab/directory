---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page could not be found.">
  <div class="not-found">
    <h1>404</h1>
    <p>We couldn't find that page.</p>
    <p>
      If you followed a link to a specific module and it's gone, the package may have left{' '}
      <a href="https://package-maven.com/" rel="noopener">PackageMaven</a>'s index — the
      directory rebuilds daily from PackageMaven's data, and packages that drop out of that index
      drop out of this directory too.
    </p>
    <p><a href="/">← Back to the directory</a></p>
  </div>
</Base>
