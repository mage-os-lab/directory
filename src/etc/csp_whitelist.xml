<?xml version="1.0"?>
<!--
    connect-src serves Direct mode, where each admin browser fetches the feed from the
    directory host; Proxy mode fetches it server-side. frame-src serves the package detail
    modal, which frames the directory site in either mode. Moving the directory to another
    host means changing this file and Config::BASE_URL.
-->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="connect-src">
            <values>
                <value id="mageos_directory" type="host">directory.mage-os.org</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="mageos_directory" type="host">directory.mage-os.org</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
